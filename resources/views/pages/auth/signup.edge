  <!-- Script simple pour basculer l'affichage des blocs selon le rôle choisi -->
  <script>
    function toggleRoleFields(role) {
      document.querySelectorAll('.role-fields').forEach(el => el.classList.add('hidden'));
      if (role === 'eleve') {
        document.getElementById('fields-eleve').classList.remove('hidden');
      } else if (role === 'enseignant') {
        document.getElementById('fields-enseignant').classList.remove('hidden');
      } else if (role === 'prefet' || role === 'directeur') {
        document.getElementById('fields-admin').classList.remove('hidden');
      }
    }
  </script>

@end
