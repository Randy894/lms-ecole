  <div class="p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-xs space-y-1">
    <p class="font-bold">Oups ! Validation échouée :</p>
    <ul class="list-disc pl-4">
      {{-- Si les erreurs sont sous forme de tableau simple ou d'objet --}}
      @if(Array.isArray(flashMessages.get('errors')))
        @each(error in flashMessages.get('errors'))
          <li>{{ error.message || error }}</li>
        @end
      @else
        {{-- Si les erreurs sont un objet de type { champ: [messages] } --}}
        @each((messages, field) in flashMessages.get('errors'))
          <li><strong>{{ field }}</strong> : {{ messages[0] }}</li>
        @end
      @endif
    </ul>
  </div>
@endif

