@component('components/layout', { title: 'Connexion - GSM Cams' })

  <div class="min-h-[85vh] grid grid-cols-1 lg:grid-cols-2 bg-white rounded-3xl border border-neutral-200 overflow-hidden shadow-sm my-4">

    <!-- Colonne de gauche : Image & Branding -->
    <div class="relative hidden lg:flex flex-col justify-between p-12 bg-neutral-900 text-white overflow-hidden">
      <!-- Image de fond avec overlay sombre -->
      <div class="absolute inset-0 z-0">
