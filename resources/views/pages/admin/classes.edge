<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Gestion des Classes - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 flex min-h-screen">
  <aside class="w-64 bg-neutral-900 text-white p-6 flex flex-col justify-between">
    <div>
      <h1 class="font-bold text-lg mb-8">GSM Cams Admin</h1>
      <nav class="space-y-3 text-sm">
        <a href="/admin/dashboard" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">🏠 Tableau de bord</a>
        <a href="/admin/users" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">👥 Utilisateurs</a>
        <a href="/admin/classes" class="block py-2 px-3 rounded-lg bg-neutral-800 text-white font-semibold">🏫 Classes</a>
        <a href="/admin/enrollments" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">📝 Inscriptions</a>
        <a href="/admin/assignments" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">📚 Attributions</a>
      </nav>
    </div>
    <div>
      <form action="/logout" method="POST">
        {{ csrfField() }}
        <button type="submit" class="w-full text-left py-2 px-3 rounded-lg text-red-400 hover:bg-neutral-800 text-sm font-semibold">🚪 Déconnexion</button>
      </form>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Gestion des Classes</h2>

      <!-- Formulaire d'ajout de classe -->
      <form action="/admin/classes" method="POST" class="bg-white p-6 rounded-xl border border-neutral-200 mb-8 flex gap-4 shadow-sm">
        {{ csrfField() }}
        <input type="text" name="name" placeholder="Nom de la classe (ex: 5e Année Secondaire)" class="flex-1 border border-neutral-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-600" required>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition shadow-sm">Ajouter la classe</button>
      </form>

      <!-- Liste des classes -->
      <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-neutral-100 text-neutral-600 border-b border-neutral-200">
            <tr>
              <th class="p-4">ID</th>
              <th class="p-4">Nom de la classe</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            @each(c in classes)
            <tr>
              <td class="p-4 text-neutral-500 font-mono">#{{ c.id }}</td>
              <td class="p-4 font-bold text-neutral-900">{{ c.name }}</td>
            </tr>
            @endeach
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
