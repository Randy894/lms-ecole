<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Inscriptions - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 flex min-h-screen">
  <aside class="w-64 bg-neutral-900 text-white p-6 flex flex-col justify-between">
    <div>
      <h1 class="font-bold text-lg mb-8">GSM Cams Admin</h1>
      <nav class="space-y-3 text-sm">
        <a href="/admin/dashboard" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">🏠 Tableau de bord</a>
        <a href="/admin/users" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">👥 Utilisateurs</a>
        <a href="/admin/classes" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">🏫 Classes</a>
        <a href="/admin/enrollments" class="block py-2 px-3 rounded-lg bg-neutral-800 text-white font-semibold">📝 Inscriptions</a>
        <a href="/admin/assignments" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">📚 Attributions</a>
      </nav>
    </div>
    <div>
      <form action="/logout" method="POST">
        {{ csrfField() }}
        <button type="submit" class="w-full text-left py-2 px-3 rounded-lg text-red-400 hover:bg-neutral-800 text-sm font-semibold">🚪 Déconnexion</button>
      </form>
    </div>
  </aside>

  <main class="flex-1 p-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Inscriptions des Élèves</h2>

      <!-- Formulaire d'inscription -->
      <form action="/admin/enrollments" method="POST" class="bg-white p-6 rounded-xl border border-neutral-200 mb-8 flex gap-4 shadow-sm">
        {{ csrfField() }}
        <select name="studentId" class="flex-1 border border-neutral-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-600" required>
          <option value="">Sélectionner un élève</option>
          @each(s in students)
            <option value="{{ s.id }}">{{ s.user ? s.user.fullName : 'Élève #' + s.id }}</option>
          @endeach
        </select>
        <select name="classId" class="flex-1 border border-neutral-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-600" required>
          <option value="">Sélectionner une classe</option>
          @each(c in classes)
            <option value="{{ c.id }}">{{ c.name }}</option>
          @endeach
        </select>
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition shadow-sm">Inscrire</button>
      </form>

      <!-- Liste des inscriptions existantes -->
      <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-neutral-100 text-neutral-600 border-b border-neutral-200">
            <tr>
              <th class="p-4">Élève</th>
              <th class="p-4">Classe assignée</th>
              <th class="p-4">Statut</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            @each(e in enrollments)
            <tr>
              <td class="p-4 font-semibold text-neutral-900">{{ e.student?.user?.fullName || 'Inconnu' }}</td>
              <td class="p-4 text-neutral-700">{{ e.schoolClass?.name || 'Classe non assignée' }}</td>
              <td class="p-4">
                <span class="px-3 py-1 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-bold uppercase">
                  {{ e.status }}
                </span>
              </td>
            </tr>
            @endeach
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
