<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Attributions - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 flex min-h-screen">
  <!-- Sidebar -->
  <aside class="w-64 bg-neutral-900 text-white p-6 flex flex-col justify-between">
    <div>
      <h1 class="font-bold text-lg mb-8">GSM Cams Admin</h1>
      <nav class="space-y-3 text-sm">
        <a href="/admin/dashboard" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">🏠 Tableau de bord</a>
        <a href="/admin/users" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">👥 Utilisateurs</a>
        <a href="/admin/classes" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">🏫 Classes</a>
        <a href="/admin/enrollments" class="block py-2 px-3 rounded-lg hover:bg-neutral-800 text-neutral-400">📝 Inscriptions</a>
        <a href="/admin/assignments" class="block py-2 px-3 rounded-lg bg-neutral-800 text-white font-semibold">📚 Attributions</a>
      </nav>
    </div>
    <div>
      <form action="/logout" method="POST">
        {{ csrfField() }}
        <button type="submit" class="w-full text-left py-2 px-3 rounded-lg text-red-400 hover:bg-neutral-800 text-sm font-semibold">🚪 Déconnexion</button>
      </form>
    </div>
  </aside>

  <!-- Contenu Principal -->
  <main class="flex-1 p-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Attributions des Enseignants</h2>

      <!-- Formulaire d'ajout d'une attribution -->
      <form action="/admin/assignments" method="POST" class="bg-white p-6 rounded-xl border border-neutral-200 mb-8 grid grid-cols-1 md:grid-cols-5 gap-4 shadow-sm">
        {{ csrfField() }}
        <select name="teacherId" class="border border-neutral-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-600" required>
          <option value="">Sélectionner un enseignant</option>
          @each(t in teachers)
            <option value="{{ t.id }}">{{ t.user ? t.user.fullName : 'Prof #' + t.id }}</option>
          @endeach
        </select>

        <select name="classId" class="border border-neutral-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-600" required>
          <option value="">Sélectionner une classe</option>
          @each(c in classes)
            <option value="{{ c.id }}">{{ c.name }}</option>
          @endeach
        </select>

        <select name="subjectId" class="border border-neutral-200 rounded-xl px-4 py-2.5 text-sm bg-white focus:outline-none focus:border-blue-600" required>
          <option value="">Sélectionner une matière</option>
          @each(s in subjects)
            <option value="{{ s.id }}">{{ s.name }}</option>
          @endeach
        </select>

        <input type="text" name="academicYear" placeholder="Année (ex: 2025-2026)" class="border border-neutral-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-blue-600" required>

        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition shadow-sm">Attribuer</button>
      </form>

      <!-- Liste des attributions existantes -->
      <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-neutral-100 text-neutral-600 border-b border-neutral-200">
            <tr>
              <th class="p-4">Enseignant</th>
              <th class="p-4">Classe</th>
              <th class="p-4">Matière</th>
              <th class="p-4">Année académique</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            @each(a in assignments)
            <tr>
              <td class="p-4 font-semibold text-neutral-900">{{ a.teacher?.user?.fullName || 'Inconnu' }}</td>
              <td class="p-4 text-neutral-700">{{ a.schoolClass?.name || 'Inconnue' }}</td>
              <td class="p-4 text-neutral-700">{{ a.subject?.name || 'Inconnue' }}</td>
              <td class="p-4 text-neutral-500 font-mono">{{ a.academicYear }}</td>
            </tr>
            @endeach
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
