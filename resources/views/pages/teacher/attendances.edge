<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestion des Présences - GSM Cams</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 text-neutral-900 font-sans antialiased min-h-screen flex">

  <!-- Sidebar -->
  <aside class="w-64 bg-white border-r border-neutral-200 hidden md:flex flex-col justify-between p-6">
    <div>
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-red-600 text-white flex items-center justify-center font-bold text-lg shadow-md">GSM</div>
        <div>
          <h1 class="font-bold text-sm tracking-wide">GSM Cams</h1>
          <p class="text-xs text-neutral-500">Espace Enseignant</p>
        </div>
      </div>
      <nav class="space-y-1.5 text-sm font-medium">
        <a href="/enseignant/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition"><span>🏠 Tableau de bord</span></a>
        <a href="/enseignant/courses" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition"><span>📚 Mes Cours</span></a>
        <a href="/enseignant/assignments" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition"><span>📝 Devoirs & Tâches</span></a>
        <a href="/enseignant/grades" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition"><span>📊 Encodage des Notes</span></a>
        <a href="/enseignant/attendances" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 text-red-600 font-semibold transition"><span>👥 Présences</span></a>
      </nav>
    </div>
    <div>
      <form action="/logout" method="POST">
        {{ csrfField() }}
        <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-red-50 text-red-600 font-semibold transition text-sm"><span>🚪 Déconnexion</span></button>
      </form>
    </div>
  </aside>

  <!-- Contenu Principal -->
  <main class="flex-1 p-8 overflow-y-auto">
    <header class="flex justify-between items-center mb-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Feuille de Présence</h2>
        <p class="text-sm text-neutral-500">Faites l'appel et suivez l'assiduité des élèves par classe.</p>
      </div>
      <a href="/enseignant/dashboard" class="text-xs bg-neutral-900 text-white px-4 py-2.5 rounded-xl font-medium hover:bg-neutral-800 transition shadow-sm">&larr; Retour</a>
    </header>

    <!-- Sélection classe et date -->
    <section class="bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm mb-8">
      <h3 class="text-lg font-bold mb-4">Sélectionner la classe et la date</h3>
      <form action="/enseignant/attendances" method="GET" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
          <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Classe</label>
          <select name="classId" required class="w-full px-3 py-2.5 rounded-xl border border-neutral-200 text-sm bg-white focus:outline-none focus:border-red-600">
            <option value="">-- Choisir une classe --</option>
            @each(a in teachingAssignments)
              <option value="{{ a.schoolClass.id }}" {{ classId == a.schoolClass.id ? 'selected' : '' }}>
                {{ a.schoolClass.name }} ({{ a.subject.name }})
              </option>
            @endeach
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Date</label>
          <input type="date" name="date" value="{{ date }}" required class="px-3 py-2.5 rounded-xl border border-neutral-200 text-sm focus:outline-none focus:border-red-600">
        </div>
        <button type="submit" class="bg-neutral-900 text-white px-5 py-2.5 rounded-xl font-medium text-sm hover:bg-neutral-800 transition">Afficher la liste</button>
      </form>
    </section>

    <!-- Tableau d'appel si des élèves sont trouvés -->
    @if(students && students.length > 0)
      <section class="bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm">
        <h3 class="text-lg font-bold mb-4">Feuille d'appel du <span class="text-red-600">{{ date }}</span></h3>

        <form action="/enseignant/attendances" method="POST">
          {{ csrfField() }}
          <input type="hidden" name="classId" value="{{ classId }}">
          <input type="hidden" name="date" value="{{ date }}">

          <div class="overflow-x-auto mb-6">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-neutral-200 text-xs font-bold uppercase tracking-wider text-neutral-400">
                  <th class="py-3 px-4">Élève</th>
                  <th class="py-3 px-4">Statut</th>
                  <th class="py-3 px-4">Justifié ?</th>
                  <th class="py-3 px-4">Commentaire</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-100 text-sm">
                @each(student in students)
                  <tr class="hover:bg-neutral-50">
                    <td class="py-3 px-4 font-semibold text-neutral-800">
                      {{ student.user ? student.user.fullName : 'Élève #' + student.id }}
                    </td>
                    <td class="py-3 px-4">
                      <select name="attendance[{{ student.id }}][status]" class="px-3 py-1.5 rounded-lg border border-neutral-200 text-xs font-semibold bg-white focus:outline-none focus:border-red-600">
                        <option value="present" {{ (!existingAttendances[student.id] || existingAttendances[student.id].status === 'present') ? 'selected' : '' }}>Présent</option>
                        <option value="absent" {{ (existingAttendances[student.id] && existingAttendances[student.id].status === 'absent') ? 'selected' : '' }}>Absent</option>
                        <option value="late" {{ (existingAttendances[student.id] && existingAttendances[student.id].status === 'late') ? 'selected' : '' }}>Retard</option>
                      </select>
                    </td>
                    <td class="py-3 px-4">
                      <input type="checkbox" name="attendance[{{ student.id }}][justification]" value="true" {{ (existingAttendances[student.id] && existingAttendances[student.id].justification) ? 'checked' : '' }} class="rounded border-neutral-300 text-red-600 focus:ring-red-500 w-4 h-4">
                    </td>
                    <td class="py-3 px-4">
                      <input type="text" name="attendance[{{ student.id }}][comment]" value="{{ existingAttendances[student.id] ? (existingAttendances[student.id].comment || '') : '' }}" placeholder="Motif..." class="w-full px-3 py-1.5 rounded-lg border border-neutral-200 text-xs focus:outline-none focus:border-red-600">
                    </td>
                  </tr>
                @endeach
              </tbody>
            </table>
          </div>

          <button type="submit" class="bg-red-600 text-white font-semibold px-6 py-3 rounded-xl text-sm hover:bg-red-700 transition shadow-sm">Valider l'appel</button>
        </form>
      </section>
    @elseif(classId)
      <div class="bg-white border border-neutral-200 rounded-2xl p-12 text-center text-neutral-400">
        <p class="text-sm">Aucun élève inscrit dans cette classe pour le moment.</p>
      </div>
    @else
      <div class="bg-white border border-neutral-200 rounded-2xl p-12 text-center text-neutral-400">
        <p class="text-sm">Veuillez sélectionner une classe et une date ci-dessus pour afficher la feuille d'appel.</p>
      </div>
    @endif

  </main>
</body>
</html>
