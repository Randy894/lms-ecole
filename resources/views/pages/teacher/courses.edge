<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mes Cours - GSM Cams</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 text-neutral-900 font-sans antialiased min-h-screen flex">

  <!-- Sidebar de navigation -->
  <aside class="w-64 bg-white border-r border-neutral-200 hidden md:flex flex-col justify-between p-6">
    <div>
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-red-600 text-white flex items-center justify-center font-bold text-lg shadow-md">
          GSM
        </div>
        <div>
          <h1 class="font-bold text-sm tracking-wide">GSM Cams</h1>
          <p class="text-xs text-neutral-500">Espace Enseignant</p>
        </div>
      </div>

      <nav class="space-y-1.5 text-sm font-medium">
        <a href="/enseignant/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition">
          <span>🏠 Tableau de bord</span>
        </a>
        <a href="/enseignant/courses" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-50 text-red-600 font-semibold transition">
          <span>📚 Mes Cours</span>
        </a>
        <a href="/enseignant/assignments" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition">
          <span>📝 Devoirs & Tâches</span>
        </a>
        <a href="/enseignant/grades" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition">
          <span>📊 Encodage des Notes</span>
        </a>
        <a href="/enseignant/attendances" class="flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-neutral-100 text-neutral-600 transition">
          <span>👥 Présences</span>
        </a>
      </nav>
    </div>

    <div>
      <form action="/logout" method="POST">
        {{ csrfField() }}
        <button type="submit" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl hover:bg-red-50 text-red-600 font-semibold transition text-sm">
          <span>🚪 Déconnexion</span>
        </button>
      </form>
    </div>
  </aside>

  <!-- Contenu Principal -->
  <main class="flex-1 p-8 overflow-y-auto">
    <header class="flex justify-between items-center mb-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Gestion des Cours</h2>
        <p class="text-sm text-neutral-500">Consultez vos matières et publiez de nouveaux contenus pédagogiques.</p>
      </div>
      <a href="/enseignant/dashboard" class="text-xs bg-neutral-900 text-white px-4 py-2.5 rounded-xl font-medium hover:bg-neutral-800 transition shadow-sm">
        &larr; Retour au tableau de bord
      </a>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Formulaire d'ajout de cours -->
      <section class="bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm h-fit">
        <h3 class="text-lg font-bold mb-4">Ajouter un nouveau cours</h3>

        <form action="/enseignant/courses" method="POST" class="space-y-4">
          {{ csrfField() }}

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Titre du cours</label>
            <input type="text" name="title" required placeholder="Ex: Algèbre Avancée" class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 text-sm focus:outline-none focus:border-red-600">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Description courte</label>
            <textarea name="description" rows="2" placeholder="Résumé du contenu..." class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 text-sm focus:outline-none focus:border-red-600"></textarea>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Contenu / Notes de cours</label>
            <textarea name="content" rows="4" placeholder="Détails, chapitres..." class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 text-sm focus:outline-none focus:border-red-600"></textarea>
          </div>

          <!-- Sélection de la classe -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Classe concernée</label>
            <select name="classId" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 text-sm bg-white focus:outline-none focus:border-red-600">
              <option value="">-- Choisir une classe --</option>
              @if(schoolClasses && schoolClasses.length > 0)
                @each(sc in schoolClasses)
                  <option value="{{ sc.id }}">{{ sc.name }}</option>
                @endeach
              @else
                <option value="" disabled>Aucune classe disponible</option>
              @endif
            </select>
          </div>

          <!-- Sélection de la matière -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-neutral-500 mb-1">Matière</label>
            <select name="subjectId" required class="w-full px-4 py-2.5 rounded-xl border border-neutral-200 text-sm bg-white focus:outline-none focus:border-red-600">
              <option value="">-- Choisir une matière --</option>
              @if(subjects && subjects.length > 0)
                @each(sub in subjects)
                  <option value="{{ sub.id }}">{{ sub.name }}</option>
                @endeach
              @else
                <option value="" disabled>Aucune matière disponible</option>
              @endif
            </select>
          </div>

          <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-3 rounded-xl text-sm transition shadow-sm">
            Enregistrer le cours
          </button>
        </form>
      </section>

      <!-- Liste des cours existants -->
      <section class="lg:col-span-2 bg-white border border-neutral-200 rounded-2xl p-6 shadow-sm">
        <h3 class="text-lg font-bold mb-4">Mes cours dispensés</h3>

        @if(courses && courses.length > 0)
          <div class="space-y-4">
            @each(course in courses)
              <div class="border border-neutral-100 bg-neutral-50/50 p-5 rounded-xl hover:border-neutral-200 transition">
                <div class="flex justify-between items-start mb-2">
                  <h4 class="font-bold text-neutral-900 text-base">{{ course.title }}</h4>
                  <span class="text-xs bg-red-50 text-red-600 font-semibold px-3 py-1 rounded-full border border-red-100">
                    {{ course.schoolClass ? course.schoolClass.name : 'Classe #' + course.classId }}
                  </span>
                </div>
                <p class="text-sm text-neutral-600 mb-3">{{ course.description || 'Aucune description fournie.' }}</p>
                <div class="text-xs text-neutral-400">
                  Matière : <span class="font-medium text-neutral-700">{{ course.subject ? course.subject.name : 'Matière #' + course.subjectId }}</span>
                </div>
              </div>
            @endeach
          </div>
        @else
          <div class="text-center py-16 text-neutral-400">
            <p class="text-sm">Aucun cours créé pour le moment. Utilisez le formulaire pour en ajouter un.</p>
          </div>
        @endif
      </section>

    </div>
  </main>

</body>
</html>
