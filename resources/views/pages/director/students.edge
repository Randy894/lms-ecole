<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Élèves - Direction</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 min-h-screen flex">
  <aside class="w-64 bg-neutral-900 text-white p-6 flex flex-col justify-between">
    <div>
      <h1 class="font-bold text-lg mb-8">GSM Cams Direction</h1>
      <nav class="space-y-1.5 text-sm font-medium">
        <a href="/directeur/dashboard" class="block py-2 px-3 text-neutral-400">🏠 Tableau de bord</a>
        <a href="/directeur/teachers" class="block py-2 px-3 text-neutral-400">👨‍🏫 Corps Enseignant</a>
        <a href="/directeur/students" class="block py-2 px-3 bg-neutral-800 text-white font-semibold rounded-lg">🎓 Suivi Élèves</a>
        <a href="/directeur/reports" class="block py-2 px-3 text-neutral-400">📊 Rapports & Notes</a>
      </nav>
    </div>
  </aside>
  <main class="flex-1 p-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Registre des Élèves Inscrits</h2>
      <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-neutral-100 text-neutral-600 border-b border-neutral-200">
            <tr>
              <th class="p-4">N° Élève</th>
              <th class="p-4">Nom complet</th>
              <th class="p-4">Classe Actuelle</th>
              <th class="p-4">Statut</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            @each(s in students)
            <tr>
              <td class="p-4 font-mono text-neutral-500">{{ s.studentNumber }}</td>
              <td class="p-4 font-semibold text-neutral-900">{{ s.user?.fullName || 'N/A' }}</td>
              <td class="p-4 text-neutral-700">{{ s.enrollments?.[0]?.schoolClass?.name || 'Non inscrit' }}</td>
              <td class="p-4">
                <span class="px-3 py-1 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-bold uppercase">
                  {{ s.status }}
                </span>
              </td>
            </tr>
            @endeach
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
