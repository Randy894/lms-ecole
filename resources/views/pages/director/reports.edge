<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Rapports - Direction</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-neutral-50 min-h-screen flex">
  <aside class="w-64 bg-neutral-900 text-white p-6 flex flex-col justify-between">
    <div>
      <h1 class="font-bold text-lg mb-8">GSM Cams Direction</h1>
      <nav class="space-y-1.5 text-sm font-medium">
        <a href="/directeur/dashboard" class="block py-2 px-3 text-neutral-400">🏠 Tableau de bord</a>
        <a href="/directeur/teachers" class="block py-2 px-3 text-neutral-400">👨‍🏫 Corps Enseignant</a>
        <a href="/directeur/students" class="block py-2 px-3 text-neutral-400">🎓 Suivi Élèves</a>
        <a href="/directeur/reports" class="block py-2 px-3 bg-neutral-800 text-white font-semibold rounded-lg">📊 Rapports & Notes</a>
      </nav>
    </div>
  </aside>
  <main class="flex-1 p-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold mb-6">Dernières Évaluations & Notes Enregistrées</h2>
      <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-neutral-100 text-neutral-600 border-b border-neutral-200">
            <tr>
              <th class="p-4">Élève</th>
              <th class="p-4">Matière</th>
              <th class="p-4">Évaluation</th>
              <th class="p-4">Note obtenue</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            @each(g in grades)
            <tr>
              <td class="p-4 font-semibold text-neutral-900">{{ g.student?.user?.fullName || 'N/A' }}</td>
              <td class="p-4 text-neutral-700">{{ g.assessment?.subject?.name || 'N/A' }}</td>
              <td class="p-4 text-neutral-600">{{ g.assessment?.title || 'Examen' }}</td>
              <td class="p-4 font-bold text-neutral-900">{{ g.score }} / {{ g.assessment?.maxScore || 20 }}</td>
            </tr>
            @endeach
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
